# Copy to /etc/rustsheet-gym/gym.env on the gym host (chmod 600). Never commit the real file.

# Secret path segment for every gym route: generate with `openssl rand -base64 33 | tr '+/' '-_' | tr -d '='`.
GYM_TOKEN=

# Tailscale Funnel origin of this host, e.g. https://gym.your-tailnet.ts.net
GYM_PUBLIC_ORIGIN=

# The gym workbook in the automation account's OneDrive, opened in Excel for the web
# (open it in a browser and copy the address bar URL).
EXCEL_WORKBOOK_URL=

# Automation account.
M365_USERNAME=
M365_PASSWORD=
# Base32 secret of the account's authenticator-app MFA method (shown as "Can't scan the code?").
M365_TOTP_SECRET=

# Optional.
# GYM_VIEWPORT=1600x1000
# GYM_DEVICE_SCALE=1
